# Local .terraform directory (contains binaries and modules)
**/.terraform/*

# .tfstate files (contains sensitive data and infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
*.log

# Exclude all .tfvars files by default (likely contain secrets)
*.tfvars
*.tfvars.json

# Ignore override files (used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
